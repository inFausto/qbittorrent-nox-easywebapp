# Copy to .env and change every value marked CHANGE_ME.

# --- web page ---
WEB_PORT=8083
# password to open the page (recommended; any user name)
WEB_PASSWORD=CHANGE_ME

# --- qBittorrent in the compose container ---
QBIT_URL=http://qbittorrent-nox:8082
QBIT_USER=admin
QBIT_PASS=CHANGE_ME
# qBittorrent installed on the server (outside Docker):
# QBIT_URL=http://host.docker.internal:8082

# user/group that owns the media folders, and the time zone
PUID=1000
PGID=1000
TZ=UTC

QBT_VERSION=5.2.4-1
QBT_LEGAL_NOTICE=confirm
QBT_WEBUI_PORT=8082
QBT_TORRENTING_PORT=6881

QBT_CONFIG_PATH=./qbittorrent/config
QBT_DOWNLOADS_PATH=./downloads
QBT_FILMS_PATH=./media/Films
QBT_MUSICS_PATH=./media/Musics
QBT_SERIETV_PATH=./media/SerieTv
